{
  "name": "onova",
  "version": "1.0.7",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/mobileapp.git"
  },
  "scripts": {
    "build-android": "cd android/ && ./gradlew assembleRelease",
    "flow-check": "flow check",
    "flow-start": "flow start",
    "flow-stop": "flow stop",
    "flow": "flow",
    "nuke-android": "yarn nuke-bundler && cd android/ && ./gradlew clean && cd ..",
    "nuke-bundler": "watchman watch-del-all && rm -rf $TMPDIR/react-*",
    "nuke-ios": "yarn nuke-bundler && rm -rf ios/build/ModuleCache && rm -rf ~/Library/Developer/Xcode/DerivedData/*",
    "postinstall": "flow-typed install",
    "start-emulator": "cd $ANDROID_HOME/emulator && ./emulator -avd Nexus_5X_API_25_7.1.1_ &",
    "start": "node node_modules/react-native/local-cli/cli.js start",
    "storybook": "storybook start -p 7007",
    "test": "jest",
    "test:e2e:android": "detox test -c android.emu.debug --loglevel verbose",
    "test:e2e:ios": "detox test -c ios.sim.debug",
    "test:e2e:build:ios": "detox build -c ios.sim.debug",
    "test:coverage": "jest --coverage",
    "test:lint": "eslint src --quiet",
    "test:watch": "jest __tests__ --watch"
  },
  "dependencies": {
    "@pusher/chatkit": "^0.7.16",
    "antd-mobile": "^2.1.8",
    "axios": "^0.17.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "date-fns": "^1.29.0",
    "firebase": "^4.8.1",
    "foect": "^0.1.5",
    "immutability-helper": "^2.6.4",
    "instabug-reactnative": "^2.8.1",
    "lottie-react-native": "^2.3.2",
    "native-base": "^2.7.0",
    "react": "16.4.1",
    "react-native": "0.56.0",
    "react-native-android-open-settings": "^1.0.1",
    "react-native-animatable": "^1.2.4",
    "react-native-circular-progress": "^0.2.0",
    "react-native-collapsible": "^0.10.0",
    "react-native-credit-card-input": "^0.4.1",
    "react-native-elements": "^0.19.0",
    "react-native-fast-image": "^2.2.4",
    "react-native-firebase": "^4.2.0",
    "react-native-flip-card": "^3.5.2",
    "react-native-gifted-chat": "^0.4.3",
    "react-native-i18n": "^2.0.12",
    "react-native-image-crop-picker": "^0.20.3",
    "react-native-image-pan-zoom": "^2.1.7",
    "react-native-image-zoom-viewer": "^2.2.13",
    "react-native-keyboard-accessory": "^0.1.2",
    "react-native-mentions": "^1.1.4",
    "react-native-micro-animated-button": "^0.0.21",
    "react-native-modal": "^6.4.0",
    "react-native-parsed-text": "^0.0.20",
    "react-native-permissions": "^1.1.1",
    "react-native-sentry": "^0.38.1",
    "react-native-simple-radio-button": "^2.7.2",
    "react-native-star-rating": "^1.0.9",
    "react-native-swiper": "^1.5.13",
    "react-native-tab-view": "^0.0.75",
    "react-native-vector-icons": "^4.6.0",
    "react-navigation": "1.5.8",
    "react-navigation-redux-helpers": "^1.0.1",
    "react-redux": "^5.0.7",
    "redux": "^3.7.2",
    "redux-persist": "^5.7.0",
    "redux-thunk": "^2.2.0",
    "rn-fetch-blob": "^0.10.11",
    "validator": "^9.1.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.0.0-beta.52",
    "@babel/preset-flow": "^7.0.0-beta.52",
    "@storybook/addon-actions": "^3.4.8",
    "@storybook/addon-links": "^3.4.8",
    "@storybook/addons": "^3.4.8",
    "@storybook/react-native": "^3.4.8",
    "babel-core": "^6.26.3",
    "babel-eslint": "^8.2.5",
    "babel-jest": "23.2.0",
    "babel-plugin-import": "^1.8.0",
    "babel-preset-react-native": "^5",
    "babel-runtime": "^6.26.0",
    "detox": "^8.0.0",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "eslint": "^4.14.1",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-babel": "^4.1.2",
    "eslint-plugin-flowtype": "^2.49.3",
    "eslint-plugin-import": "^2.13.0",
    "eslint-plugin-prettier": "^2.6.2",
    "eslint-plugin-react": "^7.10.0",
    "eslint-plugin-react-native": "^3.2.0",
    "flow-bin": "^0.75.0",
    "jest": "23.3.0",
    "nock": "^9.1.6",
    "prettier": "^1.12.0",
    "prop-types": "^15.6.2",
    "react-dom": "16.3.1",
    "react-native-bundle-visualizer": "^1.2.0",
    "react-native-touch-visualizer": "^0.1.0",
    "react-test-renderer": "16.4.1"
  },
  "jest": {
    "setupTestFrameworkScriptFile": "./e2e/init.js",
    "cacheDirectory": "./.cache",
    "setupFiles": [
      "./__tests__/setup"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "./__tests__/setup",
      "./__tests__/App",
      "./e2e/"
    ],
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-native-vector-icons|react-navigation|native-base-shoutem-theme|redux-persist|react-native-gifted-chat|native-base|@expo/react-native-action-sheet)"
    ],
    "globals": {
      "window": true
    }
  },
  "detox": {
    "test-runner": "jest",
    "runner-config": "e2e/config.json",
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/onova.app",
        "build": "xcodebuild -project ios/onova.xcodeproj -scheme onova -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "type": "ios.simulator",
        "name": "iPhone 6"
      },
      "android.emu.debug": {
        "binaryPath": "android/app/build/outputs/apk/app-debug.apk",
        "build": "pushd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug && popd",
        "type": "android.emulator",
        "name": "Nexus_5X_API_25_7.1.1_"
      },
      "android.emu.release": {
        "binaryPath": "android/app/build/outputs/apk/app-debug.apk",
        "build": "pushd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release && popd",
        "type": "android.emulator",
        "name": "Nexus_5X_API_25_7.1.1_"
      }
    }
  }
}
