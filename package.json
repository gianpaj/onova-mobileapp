{
  "name": "onova",
  "version": "1.7.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/mobileapp.git"
  },
  "scripts": {
    "build-android-drop": "cd android/ && ENVFILE=.env.drop ./gradlew assembleDropRelease",
    "build-android-onova": "cd android/ && ENVFILE=.env.onova ./gradlew assembleOnovaRelease",
    "start-android-drop": "ENVFILE=.env.drop react-native run-android --variant=dropDebug --appId com.onova.app",
    "start-android-onova": "ENVFILE=.env.onova react-native run-android --variant=onovaDebug --appId uno.drop.app",
    "nuke-android": "cd android/ && ./gradlew clean",
    "nuke-bundler": "watchman watch-del-all && rm -rf $TMPDIR/react-* && rm -rf /tmp/haste-map-react-native-packager-* && rm -rf /tmp/metro-bundler-cache-*",
    "nuke-ios": "yarn nuke-bundler && rm -rf ios/build/ModuleCache && rm -rf ~/Library/Developer/Xcode/DerivedData/*",
    "start-ios-drop": "ENVFILE=.env.drop react-native run-ios --simulator \"iPhone 8 Plus\" --scheme drop",
    "start-ios-onova": "ENVFILE=.env.onova react-native run-ios --simulator \"iPhone 8 Plus\" --scheme onova",
    "start-drop": "ENVFILE=.env.drop node node_modules/react-native/local-cli/cli.js start",
    "start-onova": "ENVFILE=.env.onova node node_modules/react-native/local-cli/cli.js start",
    "start-emulator": "cd $ANDROID_HOME/emulator && ./emulator -avd Nexus_5X_API_28 &",
    "storybook": "storybook start",
    "test": "jest"
  },
  "dependencies": {
    "@pusher/chatkit-client": "^1.2.2",
    "antd-mobile-rn": "^2.3.1",
    "axios": "^0.18.0",
    "babel-plugin-import": "^1.11.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "date-fns": "^1.30.0",
    "foect": "^0.1.5",
    "google-libphonenumber": "^3.2.2",
    "immutability-helper": "^2.9.0",
    "intl": "^1.2.5",
    "invariant": "^2.2.4",
    "native-base": "^2.8.1",
    "react": "16.8.3",
    "react-native": "0.59.8",
    "react-native-analytics-segment-io": "^3.1.3",
    "react-native-android-location-enabler": "^1.0.8",
    "react-native-animatable": "^1.3.0",
    "react-native-collapsible": "^1.3.0",
    "react-native-config": "^0.11.7",
    "react-native-dialog": "^5.5.0",
    "react-native-dotenv": "bars0um/react-native-dotenv",
    "react-native-elements": "^0.19.1",
    "react-native-firebase": "^5.1.1",
    "react-native-gesture-handler": "^1.1.0",
    "react-native-gifted-chat": "^0.7.0",
    "react-native-i18n": "^2.0.15",
    "react-native-image-crop-picker": "^0.21.3",
    "react-native-image-pan-zoom": "^2.1.11",
    "react-native-image-zoom-viewer": "^2.2.24",
    "react-native-keyboard-accessory": "^0.1.9",
    "react-native-markdown-renderer": "^3.2.8",
    "react-native-mentions": "^1.1.4",
    "react-native-modal": "^7.0.1",
    "react-native-modal-datetime-picker": "^6.0.0",
    "react-native-onboarding-swiper": "^0.10.0",
    "react-native-parsed-text": "^0.0.21",
    "react-native-permissions": "^1.1.1",
    "react-native-reanimated": "^1.0.0-alpha.12",
    "react-native-sentry": "^0.40.0",
    "react-native-simple-markdown": "^1.1.0",
    "react-native-sortable-list": "^0.0.23",
    "react-native-star-rating": "^1.1.0",
    "react-native-svg": "^8.0.10",
    "react-native-swiper": "^1.5.14",
    "react-native-tab-view": "^2.0.0",
    "react-native-vector-icons": "^6.4.0",
    "react-native-webview": "^2.14.0",
    "react-navigation": "1.5.11",
    "react-navigation-redux-helpers": "^1.0.3",
    "react-redux": "^5.1.1",
    "redux": "^4.0.1",
    "redux-persist": "^5.10.0",
    "redux-thunk": "^2.3.0",
    "validator": "^10.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@babel/runtime": "^7.4.5",
    "@storybook/addon-actions": "^4.1.4",
    "@storybook/addon-knobs": "^4.1.4",
    "@storybook/addon-ondevice-knobs": "^4.1.4",
    "@storybook/addon-ondevice-notes": "^4.1.4",
    "@storybook/react-native": "^4.1.4",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^24.8.0",
    "enzyme": "^3.8.0",
    "enzyme-adapter-react-16": "^1.7.0",
    "eslint": "^5.10.0",
    "eslint-config-prettier": "^3.3.0",
    "eslint-plugin-flowtype": "^3.2.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-prettier": "^3.0.0",
    "eslint-plugin-react": "^7.12.2",
    "eslint-plugin-react-native": "^3.5.0",
    "eslint-plugin-react-native-a11y": "^1.2.0",
    "flow-bin": "^0.92.0",
    "jest": "^24.8.0",
    "jest-enzyme": "^7.0.1",
    "metro-react-native-babel-preset": "^0.54.1",
    "moxios": "^0.4.0",
    "prettier": "^1.15.3",
    "react-dom": "^16.6.3",
    "react-test-renderer": "16.8.3",
    "redux-mock-store": "^1.5.3"
  },
  "jest": {
    "preset": "react-native",
    "cacheDirectory": "./.cache",
    "setupFiles": [
      "<rootDir>/__tests__/setup.js"
    ],
    "setupTestFrameworkScriptFile": "<rootDir>/__tests__/setup-enzyme.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "./__tests__/setup",
      "./__tests__/App",
      "./e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-native-vector-icons|react-navigation|native-base-shoutem-theme|redux-persist|react-native-gifted-chat|native-base|@expo/react-native-action-sheet)"
    ],
    "transform": {
      "^.+\\.(js)$": "<rootDir>/node_modules/react-native/jest/preprocessor.js"
    },
    "globals": {
      "window": true,
      "__TESTING__": true
    }
  }
}
