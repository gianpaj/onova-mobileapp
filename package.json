{
  "name": "mobile.app",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/mobileapp.git"
  },
  "scripts": {
    "start": "node node_modules/react-native/local-cli/cli.js start",
    "test": "jest __tests__",
    "test-e2e": "jest e2e --setupTestFrameworkScriptFile=./e2e/init.js --bail",
    "flow": "flow",
    "flow-check": "flow check",
    "flow-start": "flow start",
    "flow-stop": "flow stop"
  },
  "dependencies": {
    "@patwoz/react-navigation-is-focused-hoc": "^1.1.0",
    "firebase": "^4.6.2",
    "native-base": "^2.3.3",
    "react": "16.0.0",
    "react-native": "0.50.3",
    "react-native-elements": "^0.18.2",
    "react-native-fast-image": "^2.0.1",
    "react-native-gesture-handler": "^1.0.0-alpha.35",
    "react-native-google-signin": "^0.12.0",
    "react-native-image-crop-picker": "^0.18.2",
    "react-native-swiper": "^1.5.13",
    "react-native-tab-view": "^0.0.72",
    "react-native-vector-icons": "^4.4.2",
    "react-navigation": "^1.0.0-beta.21",
    "react-redux": "^5.0.6",
    "redux": "^3.7.2",
    "redux-persist": "^5.4.0",
    "redux-thunk": "^2.2.0",
    "validator": "^9.1.1"
  },
  "devDependencies": {
    "babel-eslint": "^8.0.2",
    "babel-jest": "21.2.0",
    "babel-preset-flow": "^6.23.0",
    "babel-preset-react-native": "4.0.0",
    "detox": "^5.10.0",
    "eslint": "^4.6.1",
    "eslint-config-prettier": "^2.8.0",
    "eslint-plugin-babel": "^4.1.2",
    "eslint-plugin-flowtype": "^2.39.1",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-prettier": "^2.3.1",
    "eslint-plugin-react": "^7.3.0",
    "eslint-plugin-react-native": "^3.1.0",
    "flow-bin": "^0.59.0",
    "jest": "21.2.1",
    "prettier": "^1.8.2",
    "react-test-renderer": "16.0.0"
  },
  "jest": {
    "setupTestFrameworkScriptFile": "./e2e/init.js",
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-native-vector-icons|react-navigation|native-base-shoutem-theme|redux-persist)"
    ]
  },
  "detox": {
    "runner": "jest",
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/myRN.app",
        "build": "xcodebuild -project ios/myRN.xcodeproj -scheme myRN -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "type": "ios.simulator",
        "name": "iPhone 6"
      }
    }
  }
}
