{
  "name": "myRN",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/onova/mobileapp.git"
  },
  "scripts": {
    "flow-check": "flow check",
    "flow-start": "flow start",
    "flow-stop": "flow stop",
    "flow": "flow",
    "postinstall": "rm ./node_modules/react-native/local-cli/core/__fixtures__/files/package.json && react-native link",
    "start-emulator": "cd $ANDROID_HOME/tools && ./emulator -avd Nexus_5X_API_25_7.1.1_",
    "nuke-ios": "watchman watch-del-all && rm -rf ios/build/ModuleCache && rm -rf ~/Library/Developer/Xcode/DerivedData/* && yarn start --reset-cache",
    "start": "node node_modules/react-native/local-cli/cli.js start",
    "test-e2e-android": "detox test -c android.emu.debug --loglevel verbose",
    "test-e2e-ios": "detox test -c ios.sim.debug",
    "test": "jest __tests__",
    "test:lint": "eslint src --quiet"
  },
  "dependencies": {
    "antd-mobile": "^2.1.3",
    "axios": "^0.17.1",
    "date-fns": "^1.29.0",
    "firebase": "^4.8.1",
    "immutability-helper": "^2.6.4",
    "native-base": "^2.3.5",
    "react": "16.2.0",
    "react-native": "0.52.1",
    "react-native-animatable": "^1.2.4",
    "react-native-cached-image": "^1.4.3",
    "react-native-collapsible": "^0.10.0",
    "react-native-credit-card-input": "^0.4.1",
    "react-native-elements": "^0.18.2",
    "react-native-fast-image": "^2.0.1",
    "react-native-flip-card": "^3.5.2",
    "react-native-gifted-chat": "^0.3.0",
    "react-native-image-crop-picker": "^0.18.2",
    "react-native-keyboard-manager": "^4.0.13-4",
    "react-native-simple-radio-button": "^2.7.1",
    "react-native-swiper": "^1.5.13",
    "react-native-tab-view": "^0.0.74",
    "react-native-vector-icons": "^4.4.2",
    "react-navigation": "1.0.0-beta.26",
    "react-redux": "^5.0.6",
    "redux": "^3.7.2",
    "redux-persist": "^5.4.0",
    "redux-thunk": "^2.2.0",
    "sendbird": "^3.0.51",
    "validator": "^9.1.1"
  },
  "devDependencies": {
    "babel-eslint": "^8.0.2",
    "babel-jest": "22.1.0",
    "babel-plugin-import": "^1.6.3",
    "babel-preset-flow": "^6.23.0",
    "babel-preset-react-native": "4.0.0",
    "detox": "^6.0.4",
    "eslint": "^4.6.1",
    "eslint-config-prettier": "^2.8.0",
    "eslint-plugin-babel": "^4.1.2",
    "eslint-plugin-flowtype": "^2.39.1",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-prettier": "^2.3.1",
    "eslint-plugin-react": "^7.3.0",
    "eslint-plugin-react-native": "^3.1.0",
    "flow-bin": "^0.61.0",
    "jest": "22.1.4",
    "prettier": "^1.10.2",
    "react-native-touch-visualizer": "^0.1.0",
    "react-test-renderer": "16.2.0"
  },
  "jest": {
    "setupTestFrameworkScriptFile": "./e2e/init.js",
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-native-vector-icons|react-navigation|native-base-shoutem-theme|redux-persist|@patwoz/react-navigation-is-focused-hoc)"
    ]
  },
  "detox": {
    "test-runner": "jest",
    "runner-config": "e2e/config.json",
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/myRN.app",
        "build": "xcodebuild -project ios/myRN.xcodeproj -scheme myRN -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "type": "ios.simulator",
        "name": "iPhone 6"
      },
      "android.emu.debug": {
        "binaryPath": "android/app/build/outputs/apk/app-debug.apk",
        "build": "pushd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug && popd",
        "type": "android.emulator",
        "name": "Nexus_5X_API_25_7.1.1_"
      },
      "android.emu.release": {
        "binaryPath": "android/app/build/outputs/apk/app-debug.apk",
        "build": "pushd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release && popd",
        "type": "android.emulator",
        "name": "Nexus_5X_API_25_7.1.1_"
      }
    }
  }
}
