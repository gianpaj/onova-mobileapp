{
  "presets": [
    ["babel-preset-react-native", { "decoratorsLegacy": true }],
    "@babel/preset-flow"
  ],
  "retainLines": true,
  "plugins": [
    ["import", { "libraryName": "antd-mobile" }],
    "@babel/plugin-transform-react-jsx-source"
  ],
  "env": {
    "development": {
      "plugins": ["transform-react-jsx-source"]
    },
    "production": {
      "plugins": ["transform-remove-console"]
    }
  }
}
